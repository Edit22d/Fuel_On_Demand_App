# Copy to .env and edit. Never commit real secrets.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-me-9f2c4a7b1e6d8c3f5a0b7e2d4c9f1a6b
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],10.0.2.2
DJANGO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Console demo credentials (created by `python manage.py seed_demo`)
FC_ADMIN_EMAIL=admin@fuelondemand.test
FC_ADMIN_PASSWORD=Console@2026

# Mobile API switches. Keep both `false` in production.
FC_OTP_SHOW_CODE=true
FC_OTP_ON_LOGIN=true
FC_PAYMENT_DRIVER=sandbox

# Confirmation email. Development prints messages to the backend terminal.
# For real inbox delivery, uncomment these and use your SMTP provider credentials.
# For Gmail, EMAIL_HOST_PASSWORD must be an app password.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=you@example.com
# EMAIL_HOST_PASSWORD=replace-with-your-app-password
# EMAIL_FROM=FuelOnDemand <you@example.com>

# Postgres instead of SQLite:
# DB_ENGINE=postgres
# DB_NAME=fuelondemand
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432
